# Proxy Hub release defaults. Instance overrides live in /opt/server-edge/config/proxy-hub.env.

# Node sources. Provider aggregation is mandatory; LOCAL is an optional additional node.
SERVER_EDGE_PROXY_LOCAL_NODE_ENABLED=true
SERVER_EDGE_PROXY_LOCAL_NODE_PUBLISH=true
SERVER_EDGE_PROXY_LOCAL_NODE_ADVERTISE_HOST=auto

# Unified egress is independent from node aggregation and publication.
SERVER_EDGE_PROXY_EGRESS_ENABLED=true
SERVER_EDGE_PROXY_EGRESS_POLICY=auto

# Feed exposure. Public domains are configured centrally in /opt/server-edge/config/publications.json.
SERVER_EDGE_PROXY_FEED_BIND=tailnet

# Management / node / egress exposure
SERVER_EDGE_PROXY_CONTROLLER_BIND=tailnet
SERVER_EDGE_PROXY_LOCAL_NODE_BIND=tailnet
SERVER_EDGE_PROXY_EGRESS_BIND=loopback

# Ports
SERVER_EDGE_PROXY_EGRESS_PORT=7890
SERVER_EDGE_PROXY_LOCAL_NODE_PORT=7891
SERVER_EDGE_PROXY_FEED_PORT=8780
SERVER_EDGE_PROXY_CONTROLLER_PORT=9090

# Provider and health policy
SERVER_EDGE_PROXY_PROVIDER_INTERVAL=21600
SERVER_EDGE_PROXY_HEALTH_URL=https://cp.cloudflare.com
SERVER_EDGE_PROXY_HEALTH_INTERVAL=600
SERVER_EDGE_PROXY_PROBE_INTERVAL=300
SERVER_EDGE_PROXY_HEALTH_TIMEOUT=5000
SERVER_EDGE_PROXY_AUTO_TOLERANCE=100
