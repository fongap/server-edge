{
  "schema_version": 1,
  "host_contract": {
    "os": {
      "required": true,
      "allowed": ["linux"]
    },
    "architectures": {
      "verified_priority": ["amd64", "arm64"],
      "compatible_if_dependencies_available": true
    },
    "privilege": {
      "install_requires_root_or_sudo": true
    },
    "bootstrap": {
      "required_commands": ["curl", "tar"]
    },
    "commands": {
      "required_after_bootstrap": ["bash", "curl", "tar", "jq"]
    },
    "runtime": {
      "engine": "docker",
      "compose": "v2",
      "required": true
    },
    "filesystem": {
      "default_root": "/opt/server-edge",
      "root_overridable": true,
      "requires_symlink": true,
      "requires_posix_permissions": true
    },
    "network": {
      "requires_dns": true,
      "requires_outbound_https": true,
      "requires_docker_bridge": true,
      "public_ip_required": false
    },
    "overlay": {
      "required": false,
      "current_implementation": "tailscale",
      "modes": ["auto", "off", "required"]
    },
    "adapters": {
      "package": ["apt-get"],
      "service": ["systemd"],
      "auto_install_distributions": ["ubuntu", "debian"]
    },
    "environment": {
      "allowed": ["cloud", "local", "unknown"]
    },
    "support_levels": ["verified", "supported", "compatible", "unsupported"],
    "verified_targets": [
      {
        "environment": "oracle-cloud",
        "distribution": "ubuntu",
        "version": "24.04",
        "codename": "noble",
        "architecture": "arm64",
        "service_manager": "systemd",
        "package_manager": "apt-get",
        "runtime": "docker",
        "compose": "v2",
        "overlay": "tailscale",
        "validation": [
          "bootstrap",
          "repeat-bootstrap",
          "host-contract",
          "infra-healthcheck",
          "managed-networks",
          "overlay-connected",
          "shell-executable-mode"
        ]
      }
    ]
  }
}
